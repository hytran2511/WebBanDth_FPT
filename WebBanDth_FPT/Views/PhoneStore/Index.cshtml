@using PagedList.Mvc;
@model PagedList.IPagedList<WebBanDth_FPT.Models.Product>

@{
    ViewBag.Title = "Trang Chủ - Phone Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary mt-3 mb-4 text-center">DANH SÁCH ĐIỆN THOẠI</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm text-center">
                <a href="@Url.Action("Details", "PhoneStore", new { id = item.ProductId })">
                    <img src="~/Images/@item.ImageUrl" class="card-img-top p-3" style="height: 200px; object-fit: contain;" alt="@item.ProductName" />
                </a>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-truncate">
                        <a href="@Url.Action("Details", "PhoneStore", new { id = item.ProductId })" class="text-dark text-decoration-none">
                            @item.ProductName
                        </a>
                    </h5>
                    <p class="card-text text-danger font-weight-bold" style="font-size: 1.1rem;">
                        @String.Format("{0:0,0}", item.Price) VNĐ
                    </p>
                    <div class="mt-auto">
                        <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductId, strURL = Request.Url.ToString() })" class="btn btn-success btn-block mb-2">
                            🛒 Thêm vào giỏ
                        </a>
                        <a href="@Url.Action("Details", "PhoneStore", new { id = item.ProductId })" class="btn btn-outline-info btn-block">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- THANH PHÂN TRANG (LAB 08) -->
<hr />
<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <div>
        Trang <strong>@(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber)</strong> / <strong>@Model.PageCount</strong>
    </div>
    <div>
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }))
    </div>
</div>