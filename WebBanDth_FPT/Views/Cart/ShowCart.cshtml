@model IEnumerable<WebBanDth_FPT.Models.CartItem>

@{
    ViewBag.Title = "Giỏ Hàng Của Bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary mt-3">THÔNG TIN GIỎ HÀNG</h2>
<hr />

<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>Tên sản phẩm</th>
            <th>Hình ảnh</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle"><strong>@item.ProductName</strong></td>
                <td class="align-middle"><img src="~/Images/@item.ImageUrl" style="width: 80px;" /></td>
                <td class="align-middle">@String.Format("{0:0,0}", item.UnitPrice) VNĐ</td>
                <td class="align-middle">
                    @using (Html.BeginForm("UpdateCart", "Cart", new { id = item.ProductId }))
                    {
                        <input type="number" min="1" name="txtQuantity" value="@item.Quantity" style="width: 60px; display:inline-block;" class="form-control" />
                        <button type="submit" class="btn btn-sm btn-info ml-2">Cập nhật</button>
                    }
                </td>
                <td class="align-middle text-danger font-weight-bold">@String.Format("{0:0,0}", item.GetTotalPrice()) VNĐ</td>
                <td class="align-middle">
                    <a href="@Url.Action("RemoveItem", "Cart", new { id = item.ProductId })" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }

        <!-- Hàng hiển thị Tổng theo ViewBag -->
        <tr style="font-weight:bold; text-align:right; color:red;">
            <td colspan="4">Tổng số lượng: @ViewBag.TotalQuantity</td>
            <td colspan="2">Tổng tiền: @String.Format("{0:0,0}", ViewBag.TotalAmount) VNĐ</td>
        </tr>
    </tbody>
</table>

<div class="mt-4">
    <a href="@Url.Action("Index", "PhoneStore")" class="btn btn-primary">Tiếp tục mua hàng</a>
    <a href="#" class="btn btn-success float-right">Tiến hành đặt hàng</a>
</div>