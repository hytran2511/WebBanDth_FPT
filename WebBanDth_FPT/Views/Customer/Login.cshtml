@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary mt-3">ĐĂNG NHẬP</h2>
<hr />

@using (Html.BeginForm("Login", "Customer", FormMethod.Post))
{
    <div class="form-horizontal" style="max-width: 500px;">
        @if (ViewBag.ErrorLogin != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorLogin</div>
        }

        <div class="form-group">
            <label class="control-label">Email:</label>
            <input type="email" name="Email" class="form-control" required />
        </div>

        <div class="form-group mt-3">
            <label class="control-label">Mật khẩu:</label>
            <input type="password" name="PasswordHash" class="form-control" required />
        </div>

        <div class="form-group mt-4">
            <input type="submit" value="Đăng nhập" class="btn btn-success" />
            <a href="@Url.Action("Register", "Customer")" class="btn btn-link">Chưa có tài khoản? Đăng ký ngay</a>
        </div>
    </div>
}